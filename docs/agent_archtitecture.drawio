                <mxCell id="208" value="item: Item — item.prompt used in hint text" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;" parent="201" vertex="1">
                    <mxGeometry y="270" width="270" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="210" value="&lt;i&gt;response: str and said_this_item are del&#39;d at the top of the method — TemplateTutor output must not vary with anything model-backed tutors receive.&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;" parent="1" vertex="1">
                    <mxGeometry x="2040" y="-1260" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="214" value="&lt;b&gt;① hint_level()&lt;/b&gt;&lt;div&gt;hint_level(mastery, prior_failures, band, policy)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;mastery &gt; θ_lower → base = NUDGE&lt;/div&gt;&lt;div&gt;mastery &gt; θ_lower/2 → base = TARGETED&lt;/div&gt;&lt;div&gt;else → base = WORKED_STEP&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;final = min(base + prior_failures, WORKED_STEP)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="2380" y="-1490" width="270" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="215" value="&lt;b&gt;② move_for()&lt;/b&gt;&lt;div&gt;move_for(level, moves_this_item, diagnosis.named, explained)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;level = NONE → &lt;b&gt;REFLECT&lt;/b&gt;&lt;/div&gt;&lt;div&gt;misconception confirmed + no prior REFLECT + not explained → &lt;b&gt;REFLECT&lt;/b&gt;&lt;/div&gt;&lt;div&gt;diagnosis.named = True → &lt;b&gt;REMEDIATE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;else → &lt;b&gt;HINT&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="2380" y="-1290" width="270" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="216" value="&lt;b&gt;→ REFLECT&lt;/b&gt;&lt;div&gt;Hint(text=fixed reflective prompt,&lt;/div&gt;&lt;div&gt;move=REFLECT, level=level,&lt;/div&gt;&lt;div&gt;targets=None)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="2760" y="-1530" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="217" value="&lt;b&gt;→ HINT&lt;/b&gt;&lt;div&gt;Hint(text=&#39;Check your working on...&#39;,&lt;/div&gt;&lt;div&gt;move=HINT, level=level, targets=None)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="2820" y="-1386" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="218" value="&lt;b&gt;→ REMEDIATE&lt;/b&gt;&lt;div&gt;Hint(text=_text_for(level, description, item),&lt;/div&gt;&lt;div&gt;move=REMEDIATE, level=level,&lt;/div&gt;&lt;div&gt;targets=misconception_id)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="2790" y="-1250" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="219" value="&lt;b&gt;_text_for(level, description, item)&lt;/b&gt;&lt;div&gt;NUDGE → &#39;Almost — one part does not follow...&#39;&lt;/div&gt;&lt;div&gt;TARGETED → &#39;Here is what went wrong: {description}&#39;&lt;/div&gt;&lt;div&gt;WORKED_STEP → same + &#39;Start again from the rule itself, take {item.prompt} one step at a time.&#39;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="2765" y="-1110" width="260" height="120" as="geometry"/>
