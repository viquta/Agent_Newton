                    </mxGeometry>
                </mxCell>
                <mxCell id="36" value="Be sure to read (again) the documentattion for pydantic, because base.py seems like a very central architectual file. (And I got two of them)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="1265" y="-170" width="150" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="37" style="edgeStyle=none;html=1;entryX=0.833;entryY=1.042;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="36" target="20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="38" value="&lt;strong style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt;It&#39;s the Python idiom for structural interfaces.&lt;/strong&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt; Since &lt;/span&gt;&lt;a style=&quot;color: rgb(0, 106, 177); text-decoration: rgb(0, 106, 177); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; href=&quot;vscode-webview://1q730l46t7o39gf7ps30ohjk9nl1rn52809c5ikjajgtkg38e0it/src/agent_newton/core/agents/base.py&quot;&gt;base.py&lt;/a&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt; uses &lt;/span&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em; white-space: pre-wrap;&quot;&gt;Protocol&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt;/&lt;/span&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em; white-space: pre-wrap;&quot;&gt;runtime_checkable&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt; rather than ABCs, you&#39;re doing structural typing — an implementation doesn&#39;t need to inherit from anything, it just needs the right methods. Collecting those contracts in one module (rather than scattering one per implementation file) is the standard way to make the contract itself discoverable, and it&#39;s what makes &lt;/span&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em; white-space: pre-wrap;&quot;&gt;isinstance(planner, Resumable)&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt; in &lt;/span&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em; white-space: pre-wrap;&quot;&gt;session.py&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt; meaningful — one canonical definition, checked at runtime.&lt;/span&gt;" style="shape=note;size=20;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1530" y="-200" width="320" height="265" as="geometry"/>
                </mxCell>
                <mxCell id="39" style="edgeStyle=none;html=1;entryX=0;entryY=0;entryDx=150;entryDy=100;entryPerimeter=0;" edge="1" parent="1" source="38" target="36">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="40" style="edgeStyle=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4" target="29">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="47" value="&lt;blockquote style=&quot;background: none 0% 0% / auto repeat scroll padding-box border-box rgb(242, 242, 242); border-color: rgba(0, 122, 204, 0.5); unicode-bidi: plaintext; color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; unicode-bidi: plaintext;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;structurally implements &lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word;&quot;&gt;Diagnostic&lt;/code&gt; — and &lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word;&quot;&gt;OracleAccess&lt;/code&gt;, for the two oracle classes&lt;/font&gt;&lt;/p&gt;&lt;div style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/blockquote&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="40">
                    <mxGeometry x="-0.0463" y="-1" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="41" value="in llm.py the LLMDiagnostic is the actual agent. This also holds for LLMTutor, and LLMPlanner.&lt;div&gt;why?&amp;nbsp;&lt;br&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: pre-wrap; background-color: rgb(243, 243, 243);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;so a study can swap an &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;arm&#39;s agent by config and &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;hold everything else &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;constant.&lt;/span&gt;&lt;/div&gt;" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#F9FFD8;strokeColor=#d6b656;fontColor=#666600;align=left;" vertex="1" parent="1">
                    <mxGeometry x="720" y="409.5" width="200" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="43" value="This component is called in the experiments:&amp;nbsp;&lt;div&gt;&lt;font color=&quot;#666600&quot;&gt;- Live session&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#666600&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(see session.py&lt;/font&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(243, 243, 243);&quot;&gt;(&lt;/span&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;agents.diagnostic.impl&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(243, 243, 243);&quot;&gt;), &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgba(0, 0, 0, 0.1); color: rgb(163, 21, 21); font-family: monospace; font-size: 11.7px;&quot;&gt;self.diagnostic.diagnose(...)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#666600&quot;&gt;- Offline evaluation&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#666600&quot;&gt;&lt;font color=&quot;#666600&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(see&amp;nbsp;&lt;/font&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;core/evaluation/diagnostic.py&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(243, 243, 243);&quot;&gt; scores any &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;Diagnostic&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(243, 243, 243);&quot;&gt; (typically the LLM one) against every &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;code style=&quot;font-family: monospace; color: rgb(163, 21, 21); background-color: rgba(0, 0, 0, 0.1); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;(item, misconception)&lt;/code&gt;&lt;span style=&quot;color: rgb(97, 97, 97); font-family: -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(243, 243, 243);&quot;&gt; pair the item bank can &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;produce, independent of session dynamics — that&#39;s &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;where the &quot;confusion matrix&quot; the module docstring &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;mentions comes from.&lt;/span&gt;&lt;font color=&quot;#666600&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=note;strokeWidth=2;fontSize=14;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#666600;align=left;" vertex="1" parent="1">
