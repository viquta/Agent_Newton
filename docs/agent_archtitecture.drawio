                <object placeholders="1" c4Name="base.py" c4Type="Component" c4Technology="The protocol definitions (abstract interfaces) for every agent role. And 2 dataclasses (diagnosis and Hint) which are concrete obj that flow out of agents during a session" c4Description="It&#39;s a pure type declarations file — it never executes. It defines the contracts that bind the whole architecture together without depending on any implementation." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="20">
